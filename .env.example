# Copy to `.env.local` for local development:  cp .env.example .env.local
# Every variable is validated at startup by `src/env.ts`; the app refuses to start if one is missing or invalid.

# ── Application ──────────────────────────────────────────────────────────────
# development | test | staging | production  (NODE_ENV is "production" on both staging and production)
APP_ENV=development
APP_URL=http://localhost:3000
# Release identifier (git commit SHA in CI/Docker); shown in logs, /api/health and Sentry
APP_RELEASE=dev
# web | worker
SERVICE_NAME=web
# error | warn | info | http | debug
LOG_LEVEL=debug

# ── Database & Redis (defaults match docker-compose.yml) ─────────────────────
# Host port 5433 (not 5432) so a locally installed PostgreSQL does not intercept the connection.
DATABASE_URL=postgresql://convites:convites@localhost:5433/convites
REDIS_URL=redis://localhost:6379

# ── Sentry (optional locally: leave the DSNs empty to disable) ───────────────
SENTRY_DSN=
# 0..1 — fraction of requests traced (keep low in production, e.g. 0.05)
SENTRY_TRACES_SAMPLE_RATE=1
# Browser SDK (inlined into the client bundle at build time)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1

# Build time only (CI): source map upload and release creation. Never needed at runtime.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Demo data (`npm run db:seed`; refuses to run in production) ──────────────
# Passwords of the demo logins; leave empty for the defaults documented in the README.
SEED_COUPLE_PASSWORD=
SEED_ADMIN_PASSWORD=

# ── Integration tests (`npm run test:integration`) ───────────────────────────
# Read from the shell, not from this file. Default: the convites_test database on the
# Docker Postgres. The name must end in _test (the tests empty it on every run).
# TEST_DATABASE_URL=postgresql://convites:convites@localhost:5433/convites_test
# Same for Redis: a database other than 0 (the tests flush it). Default: database 15.
# TEST_REDIS_URL=redis://localhost:6379/15
